    {
        "id":  "proattiva",
        "nome":  "Consulenza proattiva",
        "enabled":  false,
        "html":  "\u003cdiv class=\"gc\"\u003e\u003csection class=\"gc-sec\" id=\"proattiva\"\u003e\u003cdiv class=\"gc-wrap\" style=\"text-align:center\"\u003e\u003ch2 class=\"gc-h2\"\u003eConsulenza proattiva e su misura\u003c/h2\u003e\u003cp class=\"gc-lead\" style=\"margin-left:auto;margin-right:auto\"\u003eNon aspettiamo la scadenza delle tasse per parlarti. Analizziamo costantemente l\u0026#39;andamento della tua attivit\u0026#224; per proporti soluzioni di pianificazione fiscale strategica e ottimizzare il tuo carico fiscale.\u003c/p\u003e\u003c/div\u003e\u003c/section\u003e\u003c/div\u003e"
    },
    {
        "id":  "efficienza",
        "nome":  "Zero burocrazia",
